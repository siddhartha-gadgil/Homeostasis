-- Laplace expansion of a symbolic `6 × 6` determinant
/-- The characteristic polynomial of `twoRS a r F`. -/
theorem twoRS_charpoly (a r F : ℝ) (lam : ℂ) :
    (lam • (1 : Matrix (Fin 6) (Fin 6) ℂ) - toComplex (twoRS a r F)).det =
      lam ^ 6 + (twoSA1 a r F : ℂ) * lam ^ 5 + (twoSA2 a r F : ℂ) * lam ^ 4
        + (twoSA3 a r F : ℂ) * lam ^ 3 + (twoSA4 a r F : ℂ) * lam ^ 2 + (twoSA5 a r F : ℂ) * lam
        + (twoSA6 a r F : ℂ) := by
  simp [det_succ_row_zero, Fin.sum_univ_succ, twoRS, twoSA1, twoSA2, twoSA3, twoSA4, twoSA5,
    twoSA6, twoKs, toComplex_apply, Matrix.one_apply, Fin.succAbove]
  ring

set_option maxHeartbeats 40000000 in
-- normalizing degree-6 Hurwitz determinants with polynomial coefficients in three variables
/-- **The stability criterion**: for `a, r, F > 0` and `K > 0`, `twoRS a r F` is Hurwitz. -/
theorem twoRS_isHurwitz {a r F : ℝ} (ha : 0 < a) (hr : 0 < r) (hF : 0 < F)
    (hK : 0 < twoKs a r F) : IsHurwitz (twoRS a r F) := by
  refine isHurwitz_of_charpoly6 (twoRS_charpoly a r F) ?_ ?_ ?_ ?_ ?_ ?_
  · unfold twoSA1; positivity
  · unfold twoSA6; positivity
  · rw [show hurwitz6Δ₂ (twoSA1 a r F) (twoSA2 a r F) (twoSA3 a r F) = twoSΔ₂ a r F by
      unfold hurwitz6Δ₂ twoSA1 twoSA2 twoSA3 twoSΔ₂; ring]
    unfold twoSΔ₂; positivity
  · rw [show hurwitz6Δ₃ (twoSA1 a r F) (twoSA2 a r F) (twoSA3 a r F) (twoSA4 a r F)
        (twoSA5 a r F) = twoSΔ₃ a r F by
      unfold hurwitz6Δ₃ twoSA1 twoSA2 twoSA3 twoSA4 twoSA5 twoSΔ₃ twoSΔ₃_0 twoSΔ₃_1 twoSΔ₃_2
        twoSΔ₃_3 twoSΔ₃_4
      ring]
    unfold twoSΔ₃ twoSΔ₃_0 twoSΔ₃_1 twoSΔ₃_2 twoSΔ₃_3 twoSΔ₃_4
    positivity
  · rw [show hurwitz6Δ₄ (twoSA1 a r F) (twoSA2 a r F) (twoSA3 a r F) (twoSA4 a r F)
        (twoSA5 a r F) (twoSA6 a r F) = twoSΔ₄ a r F by
      unfold hurwitz6Δ₄ twoSA1 twoSA2 twoSA3 twoSA4 twoSA5 twoSA6 twoKs twoSΔ₄ twoSΔ₄_0 twoSΔ₄_1
        twoSΔ₄_2 twoSΔ₄_3 twoSΔ₄_4 twoSΔ₄_5 twoSΔ₄_6 twoSΔ₄_7 twoSΔ₄_8 twoSΔ₄_9 twoSΔ₄_10
        twoSΔ₄_11 twoSΔ₄_12
      ring]
    unfold twoSΔ₄ twoSΔ₄_0 twoSΔ₄_1 twoSΔ₄_2 twoSΔ₄_3 twoSΔ₄_4 twoSΔ₄_5 twoSΔ₄_6 twoSΔ₄_7 twoSΔ₄_8
      twoSΔ₄_9 twoSΔ₄_10 twoSΔ₄_11 twoSΔ₄_12
    positivity
  · rw [show hurwitz6Δ₅ (twoSA1 a r F) (twoSA2 a r F) (twoSA3 a r F) (twoSA4 a r F)
        (twoSA5 a r F) (twoSA6 a r F) = twoSΔ₅ a r F by
      unfold hurwitz6Δ₅ twoSA1 twoSA2 twoSA3 twoSA4 twoSA5 twoSA6 twoKs twoSΔ₅ twoSΔ₅_0 twoSΔ₅_1
        twoSΔ₅_2 twoSΔ₅_3 twoSΔ₅_4 twoSΔ₅_5 twoSΔ₅_6 twoSΔ₅_7 twoSΔ₅_8 twoSΔ₅_9 twoSΔ₅_10
        twoSΔ₅_11 twoSΔ₅_12 twoSΔ₅_13 twoSΔ₅_14 twoSΔ₅_15 twoSΔ₅_16 twoSΔ₅_17 twoSΔ₅_18 twoSΔ₅_19
        twoSΔ₅_20 twoSΔ₅_21 twoSΔ₅_22 twoSΔ₅_23 twoSΔ₅_24 twoSΔ₅_25 twoSΔ₅_26
