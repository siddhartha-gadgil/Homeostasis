  !![-3 * r * F - 3 * F, 0, 3 * a * r + 1, 3 * a * r + 1, 3 * a * r + 1, 3 * a * r + 1;
     0, -4 * F, 0, 2, 4 * a * r ^ 2 + 1, 4 * a * r ^ 2;
     -4 * r * F, -4 * r * F, -4 * a - 4 * r * F - 2, -4 * a - 4 * r * F, -4 * r * F, -4 * r * F;
     3 * r * F, 0, -3 * a * r, -3 * a * r - 3, 0, 0;
     0, 4 * F, 0, 0, -4 * a * r ^ 2 - 2, -4 * a * r ^ 2;
     3 * F, 0, 0, 0, -3 * a * r, -3 * a * r - 3]

