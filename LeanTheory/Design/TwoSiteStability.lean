/-- The factored form of `K`. -/
theorem twoKs_eq (a r F : ℝ) :
    twoKs a r F = (1 + r + r ^ 2) * (1 - 3 * a ^ 2 * r ^ 2)
      + 2 * a * (1 + r - r ^ 2 + r ^ 3 + r ^ 4) + 3 * F * r * (1 + r) * (1 - a * r) := by
  unfold twoKs; ring

/-- `K > 0` when `r(2 + 3a) ≤ 1` (the region `F_tot ≥ 2E_tot`). -/
theorem twoKs_pos_low {a r F : ℝ} (ha : 0 < a) (hr : 0 < r) (hF : 0 < F)
    (h : r * (2 + 3 * a) ≤ 1) : 0 < twoKs a r F := by
  rw [twoKs_eq]
  have har : a * r ≤ 1 / 3 := by nlinarith
  have hr2 : r ≤ 1 / 2 := by nlinarith
  have h1 : 0 < 1 - 3 * a ^ 2 * r ^ 2 := by nlinarith [mul_pos ha hr]
  have h2 : 0 < 1 + r - r ^ 2 + r ^ 3 + r ^ 4 := by nlinarith [pow_pos hr 3, pow_pos hr 4]
  have h3 : 0 < 1 - a * r := by linarith
  have := mul_pos (by positivity : (0:ℝ) < 1 + r + r ^ 2) h1
  have := mul_pos (by positivity : (0:ℝ) < 2 * a) h2
  have := mul_pos (by positivity : (0:ℝ) < 3 * F * r * (1 + r)) h3
  linarith

/-- `K` under the kinase–phosphatase symmetry `(a, r, F) ↦ (r²a, 1/r, rF)`. -/
theorem twoKs_swap {a r F : ℝ} (hr : 0 < r) :
    twoKs a r F = r ^ 2 * twoKs (r ^ 2 * a) (1 / r) (r * F) := by
  have := hr.ne'
  unfold twoKs
  field_simp
  ring

/-- `K > 0` when `2 + 3ar² ≤ r` (the region `E_tot ≥ 2F_tot`). -/
theorem twoKs_pos_high {a r F : ℝ} (ha : 0 < a) (hr : 0 < r) (hF : 0 < F)
    (h : 2 + 3 * a * r ^ 2 ≤ r) : 0 < twoKs a r F := by
  rw [twoKs_swap hr]
  refine mul_pos (by positivity) (twoKs_pos_low (by positivity) (by positivity) (by positivity) ?_)
  rw [div_mul_eq_mul_div, one_mul, div_le_one hr]
  linarith

/-- The restricted Jacobian of a steady state with given totals, in reduced coordinates. -/
theorem two_restrict_reduced {y : Fin 9 → ℝ} {r : ℝ}
    (hr3 : y 3 = r * y 4) (hy1 : y 1 = r * y 0) (hy2 : y 2 = r ^ 2 * y 0) :
    twoC * twoNet.massActionJacobian twoK y * twoB = twoRS (y 0) r (y 4) := by
  rw [two_restrict]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [twoR, twoRS, hr3, hy1, hy2] <;> ring

/-- **Stability criterion for every steady state**: if `K(S₀, E/F, F) > 0`, the steady state is
locally exponentially stable within its class. -/
theorem two_totals_classStable_of_K {Et Ft St : ℝ} {y : Fin 9 → ℝ} (hy : TwoTotals Et Ft St y)
    (hK : 0 < twoKs (y 0) (y 3 / y 4) (y 4)) :
    ∃ δ > 0, ∃ κ > 0, ∃ K > 0, ∀ (x : ℝ → Fin 9 → ℝ) (T : ℝ),
      twoNet.MassActionTrajectoryOn twoK x T → x 0 - y ∈ twoNet.stoichSubspace →
        ‖x 0 - y‖ < δ →
          ∀ t ∈ Ico 0 T, ‖x t - y‖ ^ 2 ≤ K * Real.exp (-κ * t) * ‖x 0 - y‖ ^ 2 := by
  obtain ⟨r, hr, hr3, hy1, hy2, -, -, -⟩ := hy.reduced
  have hrr : y 3 / y 4 = r := by rw [hr3, mul_div_assoc, div_self (hy.1.1 4).ne', mul_one]
  rw [hrr] at hK
  refine twoNet.classLocallyExpStable_of_restrict hy.1.2 (B := twoB) (C := twoC)
    (fun _ hu => two_proj hu) ?_
  rw [two_restrict_reduced hr3 hy1 hy2]
  exact twoRS_isHurwitz (hy.1.1 0) hr (hy.1.1 4) hK

/-- **Stability in the monostable region for unequal totals**: if one enzyme total is at least
twice the other, the (unique) positive steady state is locally exponentially stable within its
class. -/
theorem two_totals_classStable {Et Ft St : ℝ} (h : 2 * Et ≤ Ft ∨ 2 * Ft ≤ Et) {y : Fin 9 → ℝ}
    (hy : TwoTotals Et Ft St y) :
    ∃ δ > 0, ∃ κ > 0, ∃ K > 0, ∀ (x : ℝ → Fin 9 → ℝ) (T : ℝ),
      twoNet.MassActionTrajectoryOn twoK x T → x 0 - y ∈ twoNet.stoichSubspace →
        ‖x 0 - y‖ < δ →
          ∀ t ∈ Ico 0 T, ‖x t - y‖ ^ 2 ≤ K * Real.exp (-κ * t) * ‖x 0 - y‖ ^ 2 := by
  obtain ⟨r, hr, hr3, hy1, hy2, eE, eF, -⟩ := hy.reduced
  have ha := hy.1.1 0
  have hF := hy.1.1 4
  have hrr : y 3 / y 4 = r := by rw [hr3, mul_div_assoc, div_self hF.ne', mul_one]
  refine two_totals_classStable_of_K hy ?_
  rw [hrr]
  rcases h with h | h
  · refine twoKs_pos_low ha hr hF ?_
    have : 0 ≤ y 4 * (1 - r * (2 + 3 * y 0)) := by
      have : Ft - 2 * Et = y 4 * (1 - r * (2 + 3 * y 0)) := by
        rw [← eE, ← eF]; ring
      linarith
    nlinarith
  · refine twoKs_pos_high ha hr hF ?_
    have : 0 ≤ y 4 * (r - 2 - 3 * y 0 * r ^ 2) := by
      have : Et - 2 * Ft = y 4 * (r - 2 - 3 * y 0 * r ^ 2) := by
        rw [← eE, ← eF]; ring
      linarith
    nlinarith

